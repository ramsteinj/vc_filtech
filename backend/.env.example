# Copy to backend/.env and fill in. See specs/01-architecture.md §4.

# python3.12 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local PostgreSQL 18 (specs/01 §4.1)
DATABASE_URL=postgres://filtech:filtech@127.0.0.1:5432/filtech

# Fernet key for encrypting LLM API keys
# python3.12 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=

# Relative paths are resolved from backend/
MEDIA_ROOT=./media
INITIAL_DATA_DIR=../initial-data

CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=50
TIME_ZONE=Asia/Seoul
